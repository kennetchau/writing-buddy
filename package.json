{
  "name": "writing-buddy",
  "version": "0.1.0",
  "private": true,
  "description": "Private LAN novel writing app: lore + outline + local-LLM chapter generation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:js": "esbuild src/public/js/story.ts --bundle --format=iife --minify --target=es2022 --outfile=dist/src/public/js/story.js",
    "build": "tsc && npm run build:js && rm -rf dist/views && cp -r views dist/views && cp src/db/schema.sql dist/views/ && cp src/public/styles.css dist/src/public/styles.css",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node --watch dist/src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@node-rs/argon2": "^2.0.2",
    "codemirror": "^6.0.2",
    "cookie": "^0.7.2",
    "express": "^4.21.2",
    "hbs": "^4.2.0",
    "multer": "^2.4.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/hbs": "^4.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
