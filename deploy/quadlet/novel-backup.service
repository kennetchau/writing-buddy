# Novel app — nightly backup (pg_dump + images volume, 14× retention).
# One-shot, triggered by novel-backup.timer. Runs ON THE HOST (not in a
# container) so it works even while the app container is down (the script
# skips whatever is missing). backup.sh is installed next to this unit by
# deploy/install-quadlet.sh.
[Unit]
Description=Novel app backup (pg_dump + images)

[Service]
Type=oneshot
EnvironmentFile=%h/.config/systemd/user/novel.env
Environment=NOVEL_BACKUP_DIR=/srv/novel/backups
ExecStart=%h/.config/systemd/user/backup-novel.sh
