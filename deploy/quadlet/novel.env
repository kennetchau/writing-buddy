# novel.env — documentation of the intended env values for the novel stack.
# The quadlet generator on this host does NOT do ${VAR} expansion in
# .container files, so the actual values are hard-coded in
# novel-db.container / novel-app.container. This file exists so an operator
# can see the intended configuration in one place (old-build convention).

# --- database (novel-db.container) ---
DB_IMAGE=postgres:16
DB_NETWORK_ALIAS=novel-db
DB_VOLUME=novel-pgdata
POSTGRES_USER=novel
POSTGRES_PASSWORD=novel
POSTGRES_DB=novel

# --- app (novel-app.container) ---
APP_IMAGE=novel-app:latest
APP_NETWORK_ALIAS=novel-app
APP_PUBLISH_PORT=9187
APP_IMAGES_VOLUME=novel-images
DATABASE_URL=postgres://novel:novel@novel-db:5432/novel
# Verified from the old build on this host (stable podman host name).
LLAMA_URL=http://host.containers.internal:21000/v1
LLM_READ_TIMEOUT=900
IMAGES_DIR=/images
# HTTPS-only (nginx 443): Secure flag on the session cookie
COOKIE_SECURE=true
# issue-autologout capture: [req] line per request with cookie state
REQ_LOG=1
# 64-hex random; the install script generates one if you leave the
# placeholder in the unit. (Quoted — this file is parsed by systemd
# EnvironmentFile= in novel-backup.service.)
SESSION_SECRET="<generated by install-quadlet.sh>"
ADMIN_USERNAME=admin
ADMIN_PASSWORD="<set before first boot; change after login>"

# --- backup (novel-backup.service / scripts/backup.sh) ---
NOVEL_BACKUP_DIR=/srv/novel/backups
NOVEL_BACKUP_RETENTION=14
